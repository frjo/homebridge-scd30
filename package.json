{
  "name": "homebridge-scd30",
  "displayName": "SCD30 CO2 Sensor",
  "type": "module",
  "version": "1.0.0",
  "description": "Homebridge plugin for the Sensirion SCD30 CO2, temperature and humidity sensor",
  "author": "Fredrik Jonsson",
  "license": "Apache-2.0",
  "homepage": "https://github.com/frjo/homebridge-scd30#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/frjo/homebridge-scd30.git"
  },
  "bugs": {
    "url": "https://github.com/frjo/homebridge-scd30/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "scd30",
    "sensirion",
    "co2",
    "sensor",
    "temperature",
    "humidity",
    "homekit",
    "siri",
    "hoobs-plugin"
  ],
  "main": "dist/index.js",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "config.schema.json"
  ],
  "engines": {
    "node": "^20.18.0 || ^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon"
  },
  "dependencies": {
    "scd30-node": "^1.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "homebridge": "^2.0.0-beta.55",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
